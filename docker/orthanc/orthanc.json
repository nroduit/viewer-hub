{
  "Plugins" : [
    "/usr/local/share/orthanc/plugins/libOrthancAuthorization.so",
    "/usr/local/share/orthanc/plugins/libModalityWorklists.so",
    "/usr/local/share/orthanc/plugins/libOrthancDicomWeb.so"
  ],

  "HttpPort" : 8042,

  "DicomAet" : "ORTHANC",

  "DicomPort" : 4242,

  "DicomWeb" : {
    "Enable" : true,
    "Root" : "/dicomweb/",
    "EnableWado" : true,
    "WadoRoot" : "/wado",

    "Servers": {
      "Weasis": {
        "Url": "http://host.docker.internal:8081/display/dicomweb/",
        "HttpHeaders": {
          "archive" : "orthanc-local",
          "viewer": "weasis"
        }
      },
      "OHIF": {
        "Url": "http://host.docker.internal:8081/display/dicomweb/",
        "HttpHeaders": {
          "archive" : "orthanc-local",
          "viewer": "ohif"
        }
      },
      "3D Slicer": {
        "Url": "http://host.docker.internal:8081/display/dicomweb/",
        "HttpHeaders": {
          "archive" : "orthanc-local",
          "viewer": "slicer"
        }
      },
      "RadiAnt": {
        "Url": "http://host.docker.internal:8081/display/dicomweb/",
        "HttpHeaders": {
          "archive" : "orthanc-local",
          "viewer": "radiant"
        }
      },
      "MicroDicom": {
        "Url": "http://host.docker.internal:8081/display/dicomweb/",
        "HttpHeaders": {
          "archive" : "orthanc-local",
          "viewer": "microdicom"
        }
      }
    }
  },

  "RemoteAccessAllowed": true,

  "AuthenticationEnabled" : false,

//  "RegisteredUsers" : {
//    "orthanc-user" : "password"
//  },

  "DicomModalities" : {
    "Weasis": [
      "WEASIS_AE",
      "127.0.0.1",
      4242
    ],
    "RadiAnt": [
      "RADIANT",
      "127.0.0.1",
      4242
    ],
    "MicroDicom": [
      "MICRODICOM",
      "127.0.0.1",
      4242
    ],
    "Viewer-Hub": [
      "VIEWER-HUB",
      "127.0.0.1",
      8081
    ]
  }
}
