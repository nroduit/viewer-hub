<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!-- Build stamp of the immutable S3 sub-directory that holds the files of a given package
         version. Each upload writes to <version>/<build_id>/... and pins <build_id> in the launch
         codebase URL, so a re-uploaded (e.g. SNAPSHOT) version never overwrites files that a client
         is downloading. Nullable: legacy versions uploaded before this change keep their files at
         the top level <version>/... and have a null build_id. -->
    <changeSet author="viewer-hub" id="1.4-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="package_version" columnName="build_id"/>
            </not>
        </preConditions>
        <addColumn tableName="package_version">
            <column name="build_id" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <!-- Build stamp of the immutable S3 sub-directory that holds the files of a given i18n version.
         Same semantics as package_version.build_id. -->
    <changeSet author="viewer-hub" id="1.4-2">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="i18n" columnName="build_id"/>
            </not>
        </preConditions>
        <addColumn tableName="i18n">
            <column name="build_id" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <!-- Build stamp of the package folder the properties of an override config have been extracted
         from. The id of a package version does not change when the version is re-uploaded (only its
         build_id does), so this column is what allows to detect that the properties stored in db
         come from a previous build and have to be extracted again from
         <version>/<build_id>/conf. Nullable: configurations loaded before this change and group
         configurations created from the front have no build stamp. -->
    <changeSet author="viewer-hub" id="1.4-3">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="override_config" columnName="build_id"/>
            </not>
        </preConditions>
        <addColumn tableName="override_config">
            <column name="build_id" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>