<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet author="viewer-hub" id="1.3-1">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="package_version"/>
            <columnExists tableName="package_version" columnName="description"/>
        </preConditions>
        <modifyDataType tableName="package_version" columnName="description" newDataType="TEXT"/>
    </changeSet>

    <changeSet author="viewer-hub" id="1.3-2">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="weasis_property"/>
            <columnExists tableName="weasis_property" columnName="description"/>
        </preConditions>
        <modifyDataType tableName="weasis_property" columnName="description" newDataType="TEXT"/>
    </changeSet>

    <changeSet author="viewer-hub" id="1.3-3">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="i18n"/>
            <columnExists tableName="i18n" columnName="description"/>
        </preConditions>
        <modifyDataType tableName="i18n" columnName="description" newDataType="TEXT"/>
    </changeSet>

</databaseChangeLog>

