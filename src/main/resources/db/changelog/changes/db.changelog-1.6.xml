<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!-- Group deactivation: a deactivated group keeps its members but is ignored at launch resolution -->
    <changeSet author="viewer-hub" id="1.6-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="target" columnName="active"/>
            </not>
        </preConditions>
        <addColumn tableName="target">
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
