<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet author="viewer-hub" id="1.2-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="viewer_selection"/>
            </not>
        </preConditions>
        <createTable tableName="viewer_selection">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="viewer_selection_pkey"/>
            </column>
            <column name="priority" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="modality" type="VARCHAR(255)">
            </column>
            <column name="archive" type="VARCHAR(255)">
            </column>
            <column name="viewer" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="viewer-hub" id="1.2-2">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="viewer_selection"/>
            <sqlCheck expectedResult="0">SELECT COUNT(*)
                                         FROM viewer_selection
                                         WHERE archive = 'DEFAULT';</sqlCheck>
        </preConditions>
        <insert tableName="viewer_selection">
            <column name="id" valueComputed="1"/>
            <column name="priority" valueComputed="0"/>
            <column name="archive" value="DEFAULT"/>
            <column name="viewer" value="WEASIS"/>
        </insert>
    </changeSet>

</databaseChangeLog>